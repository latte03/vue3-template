{
  "name": "vue3-template",
  "type": "module",
  "version": "0.1.3",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "concurrently \"pnpm:type-check\" \"pnpm:build-only\"",
    "preview": "vite preview",
    "test": "vitest",
    "test:unit": "vitest --environment jsdom --root src/",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json --composite false",
    "eslint-viewer": "@eslint/config-inspector",
    "lint": "eslint . --fix",
    "lint:stylelint": "stylelint --cache --fix \"**/*.{vue,less,postcss,css,scss}\" --cache --cache-location node_modules/.cache/stylelint/",
    "cz": "git add . && cz",
    "bumpp": "bumpp"
  },
  "dependencies": {
    "@unocss/reset": "^66.10.5",
    "@vueuse/core": "^15.0.0",
    "@vueuse/head": "^2.0.0",
    "alova": "^3.5.5",
    "axios": "^1.20.0",
    "fast-querystring": "^1.1.2",
    "lodash-es": "^4.18.1",
    "nprogress-v2": "^1.1.10",
    "pinia": "^4.0.3",
    "tdesign-icons-vue-next": "^0.4.11",
    "tdesign-vue-next": "^1.20.8",
    "unocss": "^66.10.5",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@eslint/config-inspector": "^3.5.0",
    "@plugin-web-update-notification/vite": "^2.1.3",
    "@sxzz/eslint-config": "^8.6.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.3",
    "@unocss/eslint-plugin": "^66.10.5",
    "@unocss/preset-rem-to-px": "^66.10.5",
    "@unocss/transformer-directives": "^66.10.5",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue-macros/volar": "^3.1.4",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "bumpp": "^12.3.0",
    "commitizen": "^4.3.2",
    "commitlint": "^21.2.3",
    "concurrently": "^10.0.5",
    "cz-customizable": "^7.5.4",
    "eslint": "^10.11.0",
    "jsdom": "^30.1.1",
    "less": "^4.6.4",
    "postcss": "^8.5.28",
    "postcss-html": "^2.0.0",
    "postcss-less": "^6.0.0",
    "prettier": "^3.9.9",
    "stylelint": "^17.15.0",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-recess-order": "^7.8.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-strict-value": "^1.12.1",
    "terser": "^5.51.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-compression": "^0.0.6",
    "unplugin-info": "^1.3.2",
    "unplugin-svg-component": "^0.13.0",
    "unplugin-turbo-console": "^2.3.3",
    "unplugin-unused": "^0.6.0",
    "unplugin-vue-components": "^32.1.0",
    "unplugin-vue-inspector": "^3.0.0",
    "vite": "8.3.1",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vite-plugin-vue-meta-layouts": "^0.6.1",
    "vitest": "^5.0.2",
    "vue-macros": "3.1.4",
    "vue-tsc": "^3.3.11"
  },
  "config": {
    "cz-customizable": {
      "config": "./.cz-config.cjs"
    },
    "commitizen": {
      "path": "cz-customizable"
    }
  }
}
